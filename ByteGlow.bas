10 REM === SC719 LED SHOW (MBASIC-80) ===
20 REM Port 00h drives LEDs. Keys: 0-9 choose, 0=cycle all, +=faster, -=slower, I=invert, Q=quit
30 LP=0: IV=0: DL=180: MD=0: QT=0: CM=64
40 DIM S(8): FOR I=1 TO 8: S(I)=2^(I-1): NEXT I
50 GOSUB 6000: GOSUB 7000
60 IF QT=1 THEN 9900
70 IF MD=0 THEN GOSUB 4100 ELSE ON MD GOSUB 2100,2200,2300,2400,2500,2600,2700,2800,2900
80 GOTO 60
90 REM ------------------------- Patterns --------------------------
100 REM (Each pattern returns on mode change or Q; in MD=0 it returns after ~CM steps)
2100 CU=1: IX=1: DR=1: ST=0
2110 N=S(IX): GOSUB 7200: GOSUB 8000: ST=ST+1
2120 A$=INKEY$: IF A$<>"" THEN GOSUB 4900: IF QT=1 OR (MD<>CU AND MD<>0) THEN RETURN
2130 IF MD=0 AND ST>=CM THEN RETURN
2140 IX=IX+DR: IF IX=8 THEN DR=-1 ELSE IF IX=1 THEN DR=1
2150 GOTO 2110
2200 CU=2: ST=0
2210 FOR N=0 TO 255: GOSUB 7200: GOSUB 8000: ST=ST+1
2220 A$=INKEY$: IF A$<>"" THEN GOSUB 4900: IF QT=1 OR (MD<>CU AND MD<>0) THEN RETURN
2230 IF MD=0 AND ST>=CM THEN RETURN
2240 NEXT N
2250 GOTO 2210
2300 CU=3: ST=0
2310 FOR N=255 TO 0 STEP -1: GOSUB 7200: GOSUB 8000: ST=ST+1
2320 A$=INKEY$: IF A$<>"" THEN GOSUB 4900: IF QT=1 OR (MD<>CU AND MD<>0) THEN RETURN
2330 IF MD=0 AND ST>=CM THEN RETURN
2340 NEXT N
2350 GOTO 2310
2400 CU=4: ST=0
2410 FOR K=1 TO 8: N=2^K-1: GOSUB 7200: GOSUB 8000: ST=ST+1
2420 A$=INKEY$: IF A$<>"" THEN GOSUB 4900: IF QT=1 OR (MD<>CU AND MD<>0) THEN RETURN
2430 IF MD=0 AND ST>=CM THEN RETURN
2440 NEXT K
2450 FOR K=7 TO 0 STEP -1: N=2^K-1: GOSUB 7200: GOSUB 8000: ST=ST+1
2460 A$=INKEY$: IF A$<>"" THEN GOSUB 4900: IF QT=1 OR (MD<>CU AND MD<>0) THEN RETURN
2470 IF MD=0 AND ST>=CM THEN RETURN
2480 NEXT K
2490 GOTO 2410
2500 CU=5: IX=1: ST=0
2510 FOR IX=1 TO 8: N=S(IX): GOSUB 7200: GOSUB 8000: ST=ST+1
2520 A$=INKEY$: IF A$<>"" THEN GOSUB 4900: IF QT=1 OR (MD<>CU AND MD<>0) THEN RETURN
2530 IF MD=0 AND ST>=CM THEN RETURN
2540 NEXT IX
2550 GOTO 2510
2600 CU=6: IX=8: ST=0
2610 FOR IX=8 TO 1 STEP -1: N=S(IX): GOSUB 7200: GOSUB 8000: ST=ST+1
2620 A$=INKEY$: IF A$<>"" THEN GOSUB 4900: IF QT=1 OR (MD<>CU AND MD<>0) THEN RETURN
2630 IF MD=0 AND ST>=CM THEN RETURN
2640 NEXT IX
2650 GOTO 2610
2700 CU=7: T=0: ST=0
2710 IF T=0 THEN N=170 ELSE N=85
2720 GOSUB 7200: GOSUB 8000: ST=ST+1: T=1-T
2730 A$=INKEY$: IF A$<>"" THEN GOSUB 4900: IF QT=1 OR (MD<>CU AND MD<>0) THEN RETURN
2740 IF MD=0 AND ST>=CM THEN RETURN
2750 GOTO 2710
2800 CU=8: ST=0
2810 N=0
2820 FOR K=3 TO 0 STEP -1: N=N+2^K+2^(7-K): GOSUB 7200: GOSUB 8000: ST=ST+1
2830 A$=INKEY$: IF A$<>"" THEN GOSUB 4900: IF QT=1 OR (MD<>CU AND MD<>0) THEN RETURN
2840 IF MD=0 AND ST>=CM THEN RETURN
2850 NEXT K
2860 N=255
2870 FOR K=0 TO 3: N=N-(2^K+2^(7-K)): GOSUB 7200: GOSUB 8000: ST=ST+1
2880 A$=INKEY$: IF A$<>"" THEN GOSUB 4900: IF QT=1 OR (MD<>CU AND MD<>0) THEN RETURN
2890 IF MD=0 AND ST>=CM THEN RETURN
2895 NEXT K
2896 GOTO 2810
2900 CU=9: ST=0
2910 N=INT(RND*256): GOSUB 7200: GOSUB 8000: ST=ST+1
2920 A$=INKEY$: IF A$<>"" THEN GOSUB 4900: IF QT=1 OR (MD<>CU AND MD<>0) THEN RETURN
2930 IF MD=0 AND ST>=CM THEN RETURN
2940 GOTO 2910
4100 REM Cycle all patterns while MD=0
4110 FOR P=1 TO 9
4120 IF MD<>0 OR QT=1 THEN RETURN
4130 MD=P: ON MD GOSUB 2100,2200,2300,2400,2500,2600,2700,2800,2900
4140 MD=0
4150 NEXT P
4160 GOTO 4110
4900 REM --- Key handler ---
4910 IF A$="Q" OR A$="q" THEN QT=1: RETURN
4920 IF A$="+" THEN DL=DL+20: IF DL>800 THEN DL=800: RETURN ELSE RETURN
4930 IF A$="-" THEN DL=DL-20: IF DL<10 THEN DL=10: RETURN ELSE RETURN
4940 IF A$="I" OR A$="i" THEN IV=1-IV: RETURN
4950 N0=ASC(A$)-48: IF N0>=0 AND N0<=9 THEN MD=N0: RETURN
4960 RETURN
6000 PRINT:PRINT "SC719 LED SHOW @ 00h";
6010 PRINT "  Keys: 0-9 pick, 0=CYCLE, +/- speed, I=invert, Q=quit"
6020 RETURN
7000 REM --- All LEDs OFF respecting inversion ---
7010 IF IV=0 THEN OUT LP,0 ELSE OUT LP,255
7020 RETURN
7200 REM --- Output value N with inversion ---
7210 IF N<0 THEN N=0 ELSE IF N>255 THEN N=255
7220 IF IV=0 THEN OUT LP,N ELSE OUT LP,255-N
7230 RETURN
8000 REM --- Delay based on DL ---
8010 FOR T=1 TO DL: NEXT T
8020 RETURN
9900 GOSUB 7000: PRINT: PRINT "Done."
9910 END
