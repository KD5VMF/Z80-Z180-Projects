10 REM MAX7219 ART DEMO FOR SC719 (MBASIC-80 Rev 5.21) - RUNS UNTIL CTRL-C
20 DEFINT A-Z
30 P = &H0
40 BDIN = 1
50 BCS = 2
60 BCLK = 4
70 DIM ROW(8)
80 DIM CM(8)
90 DIM POW2(7)
100 DIM WV(8)
110 BUS = 0
120 GOSUB 1500
130 GOSUB 800
140 GOSUB 2000
150 GOSUB 2300
160 PRINT "Modes: 0=Cycle  1=Ball  2=Diag  3=Box  4=Rain  5=Wave"
170 INPUT "MODE"; MD
180 INPUT "SPD (0=fast, 1..9 slower)"; SPD
190 IF MD = 0 THEN GOSUB 5000
200 IF MD = 1 THEN LIMIT = 0: GOSUB 5100
210 IF MD = 2 THEN LIMIT = 0: GOSUB 6000
220 IF MD = 3 THEN LIMIT = 0: GOSUB 7000
230 IF MD = 4 THEN LIMIT = 0: GOSUB 8000
240 IF MD = 5 THEN LIMIT = 0: GOSUB 9000
250 GOTO 170
300 REM ----- LOW-LEVEL PORT HELPERS -----
320 BUS = (BUS OR M)
330 OUT P, BUS
340 RETURN
360 BUS = (BUS AND (255 - M))
370 OUT P, BUS
380 RETURN
400 REM PULSE CLK ONCE
410 M = BCLK
420 GOSUB 320
430 M = BCLK
440 GOSUB 360
450 RETURN
470 REM SET DIN = V (0/1)
471 IF V <> 0 THEN 480
472 M = BDIN
473 GOSUB 360
474 RETURN
480 M = BDIN
481 GOSUB 320
482 RETURN
500 REM SET CS = V (0/1)
510 IF V <> 0 THEN 530
520 M = BCS
525 GOSUB 360
526 RETURN
530 M = BCS
540 GOSUB 320
550 RETURN
560 REM SHIFT OUT BYTE IN ARG, MSB FIRST
570 FOR I = 7 TO 0 STEP -1
580 BITV = ARG AND POW2(I)
590 IF BITV <> 0 THEN V = 1 ELSE V = 0
600 GOSUB 470
610 GOSUB 400
620 NEXT I
630 RETURN
680 REM SEND WORD: ADDR THEN DB; LATCH ON CS RISING EDGE
690 V = 0
700 GOSUB 500
710 ARG = ADDR
720 GOSUB 560
730 ARG = DB
740 GOSUB 560
750 V = 1
760 GOSUB 500
770 V = 0
780 GOSUB 500
790 RETURN
800 REM ----- IDLE LINES LOW -----
810 M = BCLK
820 GOSUB 360
830 M = BDIN
840 GOSUB 360
850 M = BCS
860 GOSUB 360
870 RETURN
900 REM SMALL DELAY BASED ON SPD
910 IF SPD <= 0 THEN RETURN
920 FOR D = 1 TO SPD
930 FOR E = 1 TO 50
940 XTMP = XTMP + 1
950 NEXT E
960 NEXT D
970 RETURN
1100 REM PUSH ROW BUFFER TO DISPLAY
1110 FOR R = 1 TO 8
1120 ADDR = R
1130 DB = ROW(R)
1140 GOSUB 680
1150 NEXT R
1160 RETURN
1200 REM PLOT PIXEL (SET)
1210 IF X < 1 THEN RETURN
1220 IF X > 8 THEN RETURN
1230 IF Y < 1 THEN RETURN
1240 IF Y > 8 THEN RETURN
1250 ROW(Y) = ROW(Y) OR CM(X)
1260 RETURN
1300 REM CLEAR PIXEL (RESET)
1310 IF X < 1 THEN RETURN
1320 IF X > 8 THEN RETURN
1330 IF Y < 1 THEN RETURN
1340 IF Y > 8 THEN RETURN
1350 ROW(Y) = ROW(Y) AND (255 - CM(X))
1360 RETURN
1400 REM CLEAR BUFFER ONLY
1410 FOR R = 1 TO 8
1420 ROW(R) = 0
1430 NEXT R
1440 RETURN
1500 REM ----- INIT TABLES -----
1510 CM(1) = 128
1520 CM(2) = 64
1530 CM(3) = 32
1540 CM(4) = 16
1550 CM(5) = 8
1560 CM(6) = 4
1570 CM(7) = 2
1580 CM(8) = 1
1590 POW2(0) = 1
1600 FOR I = 1 TO 7
1610 POW2(I) = POW2(I - 1) + POW2(I - 1)
1620 NEXT I
1630 RN = RND(-1)
1640 WV(1) = 2
1650 WV(2) = 3
1660 WV(3) = 4
1670 WV(4) = 5
1680 WV(5) = 6
1690 WV(6) = 5
1700 WV(7) = 4
1710 WV(8) = 3
1720 RETURN
2000 REM ----- MAX7219 INIT -----
2010 ADDR = &H9
2020 DB = 0
2030 GOSUB 680
2040 ADDR = &HA
2050 DB = 8
2060 GOSUB 680
2070 ADDR = &HB
2080 DB = 7
2090 GOSUB 680
2100 ADDR = &HC
2110 DB = 1
2120 GOSUB 680
2130 ADDR = &HF
2140 DB = 0
2150 GOSUB 680
2160 RETURN
2300 REM ----- CLEAR DEVICE TO BLACK -----
2310 FOR R = 1 TO 8
2320 ADDR = R
2330 DB = 0
2340 GOSUB 680
2350 NEXT R
2360 GOSUB 1400
2370 RETURN
5000 REM ===== CYCLE ALL EFFECTS FOREVER =====
5010 REM CHOOSE FRAME CHUNKS PER EFFECT
5020 LIMIT = 200
5030 GOSUB 5100
5040 LIMIT = 160
5050 GOSUB 6000
5060 LIMIT = 240
5070 GOSUB 7000
5080 LIMIT = 180
5090 GOSUB 8000
5100 REM ===== BOUNCING BALL (LIMIT=0 => INFINITE) =====
5110 GOSUB 2300
5120 X = 2
5130 Y = 2
5140 VX = 1
5150 VY = 1
5160 CNT = LIMIT
5170 PX = X
5180 PY = Y
5190 X = X + VX
5200 IF X < 1 THEN X = 1
5210 IF X > 8 THEN X = 8
5220 IF X = 1 THEN VX = 1
5230 IF X = 8 THEN VX = -1
5240 Y = Y + VY
5250 IF Y < 1 THEN Y = 1
5260 IF Y > 8 THEN Y = 8
5270 IF Y = 1 THEN VY = 1
5280 IF Y = 8 THEN VY = -1
5290 X = PX
5300 Y = PY
5310 GOSUB 1300
5320 X = X + VX
5330 Y = Y + VY
5340 GOSUB 1200
5350 GOSUB 1100
5360 GOSUB 900
5370 IF LIMIT > 0 THEN CNT = CNT - 1
5380 IF LIMIT > 0 THEN IF CNT = 0 THEN RETURN
5390 GOTO 5170
6000 REM ===== DIAGONAL SWEEP (LIMIT FRAMES OR FOREVER) =====
6010 GOSUB 2300
6020 OFFS = 1
6030 CNT = LIMIT
6040 GOSUB 1400
6050 FOR R = 1 TO 8
6060 C = R + OFFS
6070 IF C > 8 THEN C = C - 8
6080 X = C
6090 Y = R
6100 GOSUB 1200
6110 NEXT R
6120 GOSUB 1100
6130 GOSUB 900
6140 OFFS = OFFS + 1
6150 IF OFFS > 8 THEN OFFS = 1
6160 IF LIMIT > 0 THEN CNT = CNT - 1
6170 IF LIMIT > 0 THEN IF CNT = 0 THEN RETURN
6180 GOTO 6040
7000 REM ===== BOX PULSE (EXPAND/SHRINK, LIMIT PER FRAME) =====
7010 GOSUB 2300
7020 CNT = LIMIT
7030 GOSUB 1400
7040 L = 1
7050 T = 1
7060 R = 8
7070 B = 8
7080 FOR RING = 0 TO 3
7090 GOSUB 1400
7100 L = 1 + RING
7110 T = 1 + RING
7120 R = 8 - RING
7130 B = 8 - RING
7140 FOR XX = L TO R
7150 X = XX
7160 Y = T
7170 GOSUB 1200
7180 Y = B
7190 GOSUB 1200
7200 NEXT XX
7210 FOR YY = T TO B
7220 Y = YY
7230 X = L
7240 GOSUB 1200
7250 X = R
7260 GOSUB 1200
7270 NEXT YY
7280 GOSUB 1100
7290 GOSUB 900
7300 IF LIMIT > 0 THEN CNT = CNT - 1
7310 IF LIMIT > 0 THEN IF CNT = 0 THEN RETURN
7320 NEXT RING
7330 FOR RING = 2 TO 1 STEP -1
7340 GOSUB 1400
7350 L = 1 + RING
7360 T = 1 + RING
7370 R = 8 - RING
7380 B = 8 - RING
7390 FOR XX = L TO R
7400 X = XX
7410 Y = T
7420 GOSUB 1200
7430 Y = B
7440 GOSUB 1200
7450 NEXT XX
7460 FOR YY = T TO B
7470 Y = YY
7480 X = L
7490 GOSUB 1200
7500 X = R
7510 GOSUB 1200
7520 NEXT YY
7530 GOSUB 1100
7540 GOSUB 900
7550 IF LIMIT > 0 THEN CNT = CNT - 1
7560 IF LIMIT > 0 THEN IF CNT = 0 THEN RETURN
7570 NEXT RING
7580 GOTO 7030
8000 REM ===== RAIN / TWINKLE (LIMIT FRAMES OR FOREVER) =====
8010 GOSUB 2300
8020 CNT = LIMIT
8030 FOR R = 8 TO 2 STEP -1
8040 ROW(R) = ROW(R - 1)
8050 NEXT R
8060 TOPB = 0
8070 DENS = 2
8080 FOR D = 1 TO DENS
8090 C = INT(RND(1) * 8) + 1
8100 TOPB = TOPB OR CM(C)
8110 NEXT D
8120 ROW(1) = TOPB
8130 GOSUB 1100
8140 GOSUB 900
8150 IF LIMIT > 0 THEN CNT = CNT - 1
8160 IF LIMIT > 0 THEN IF CNT = 0 THEN RETURN
8170 GOTO 8030
9000 REM ===== WAVE (LIMIT FRAMES OR FOREVER) =====
9010 GOSUB 2300
9020 OFFS = 1
9030 CNT = LIMIT
9040 GOSUB 1400
9050 FOR X = 1 TO 8
9060 IX = X + OFFS
9070 IF IX > 8 THEN IX = IX - 8
9080 Y = WV(IX)
9090 GOSUB 1200
9100 NEXT X
9110 GOSUB 1100
9120 GOSUB 900
9130 OFFS = OFFS + 1
9140 IF OFFS > 8 THEN OFFS = 1
9150 IF LIMIT > 0 THEN CNT = CNT - 1
9160 IF LIMIT > 0 THEN IF CNT = 0 THEN RETURN
9170 GOTO 9040
