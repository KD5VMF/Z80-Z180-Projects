10 REM MAX7219 GEOMETRIC PATTERN DEMO (20 FRAMES) — SC719 (MBASIC-80)
20 DEFINT A-Z
30 DIM ROW(8), CM(8)
40 P = &H0
50 BDIN = 1: BCS = 2: BCLK = 4
60 FOR I = 1 TO 8: CM(I) = 2 ^ (8 - I): NEXT I
70 BUS = 0
80 GOSUB 800     ' idle lines low
90 GOSUB 2000    ' init MAX7219
100 GOSUB 2300   ' clear
110 PRINT "Showing 10 non-solid + 10 solid designs..."
120 RESTORE 3000
130 FOR F = 1 TO 20
140   FOR R = 1 TO 8: READ ROW(R): NEXT R
150   GOSUB 1200  ' push ROW() to display
160   GOSUB 900   ' delay
170 NEXT F
180 GOTO 120

300 REM ===== BUS-PRESERVING BIT HELPERS =====
310 REM Set/clear a mask M in BUS and OUT P
320 BUS = (BUS OR M): OUT P, BUS: RETURN
330 BUS = (BUS AND (255 - M)): OUT P, BUS: RETURN

400 REM ===== SHIFT OUT BYTE IN ARG (MSB FIRST) =====
410 REM Uses BUS; only toggles DIN/CLK bits, leaves others intact
420 FOR I = 7 TO 0 STEP -1
430  IF (ARG AND (2 ^ I)) <> 0 THEN M = BDIN: GOSUB 320 ELSE M = BDIN: GOSUB 330
440  M = BCLK: GOSUB 320
450  M = BCLK: GOSUB 330
460 NEXT I
470 RETURN

500 REM ===== SEND WORD (ADDR then DB) with CS latch =====
510 M = BCS: GOSUB 330        ' CS = 0
520 ARG = ADDR: GOSUB 400     ' send address
530 ARG = DB:   GOSUB 400     ' send data
540 M = BCS: GOSUB 320        ' CS = 1 (latch)
550 M = BCS: GOSUB 330        ' CS = 0 (return low, like your working code)
560 RETURN

800 REM ===== IDLE LINES LOW =====
810 BUS = (BUS AND (255 - (BDIN + BCLK + BCS)))
820 OUT P, BUS
830 RETURN

900 REM ===== SMALL DELAY =====
910 FOR D = 1 TO 500: NEXT D
920 RETURN

1100 REM ===== WRITE ONE ROW (ADDR=1..8) FROM ROW(ADDR) =====
1110 DB = ROW(ADDR): GOSUB 500: RETURN

1200 REM ===== PUSH ROW() BUFFER TO DISPLAY =====
1210 FOR R = 1 TO 8
1220  ADDR = R
1230  DB = ROW(R)
1240  GOSUB 500
1250 NEXT R
1260 RETURN

2000 REM ===== MAX7219 INIT =====
2010 ADDR = &H9: DB = 0: GOSUB 500     ' decode off
2020 ADDR = &HA: DB = 8: GOSUB 500     ' intensity 0..15
2030 ADDR = &HB: DB = 7: GOSUB 500     ' scan-limit = 7 (8 rows)
2040 ADDR = &HC: DB = 1: GOSUB 500     ' normal op
2050 ADDR = &HF: DB = 0: GOSUB 500     ' test off
2060 RETURN

2300 REM ===== CLEAR DISPLAY =====
2310 FOR R = 1 TO 8
2320  ADDR = R: DB = 0: GOSUB 500
2330  ROW(R) = 0
2340 NEXT R
2350 RETURN

3000 REM ===== 10 NON-SOLID DESIGNS =====
3010 DATA 24,24,0,0,0,0,24,24
3020 DATA 129,66,36,24,24,36,66,129
3030 DATA 0,24,36,66,129,66,36,24
3040 DATA 1,2,4,8,16,32,64,128
3050 DATA 128,64,32,16,8,4,2,1
3060 DATA 24,24,24,0,0,24,24,24
3070 DATA 129,66,36,24,24,36,66,129
3080 DATA 16,16,16,16,16,16,16,16
3090 DATA 0,0,255,0,0,255,0,0
3100 DATA 85,0,85,0,85,0,85,0
