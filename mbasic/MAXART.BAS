10 REM MAX7219 ART (40) -> DIGITS 0..9 -> REPEAT  (SC719, MBASIC-80)
20 DEFINT A-Z
30 DIM ROW(8), CM(8)
40 P = &H0
50 BDIN = 1: BCS = 2: BCLK = 4
60 FOR I = 1 TO 8: CM(I) = 2 ^ (8 - I): NEXT I
70 BUS = 0
80 GOSUB 800     ' idle low
90 GOSUB 2000    ' init
100 GOSUB 2300   ' clear
110 PRINT "ART (40 frames) -> DIGITS 0..9 -> repeat"
115 ADDR=&HF: DB=1: GOSUB 500: FOR T=1 TO 1500: NEXT T: ADDR=&HF: DB=0: GOSUB 500
120 REM ===== MAIN LOOP =====
130 RESTORE 3000: GOSUB 1800    ' ART
140 GOSUB 2300: PRINT "DIGITS 0..9"
150 GOSUB 2100                  ' DIGITS
160 GOSUB 2300
170 GOTO 130
300 REM ===== BUS-PRESERVING HELPERS =====
320 BUS = (BUS OR M): OUT P, BUS: RETURN
330 BUS = (BUS AND (255 - M)): OUT P, BUS: RETURN
400 REM ===== SHIFT OUT BYTE IN ARG (MSB FIRST) =====
420 FOR I = 7 TO 0 STEP -1
430  IF (ARG AND (2 ^ I)) <> 0 THEN M = BDIN: GOSUB 320 ELSE M = BDIN: GOSUB 330
440  M = BCLK: GOSUB 320
450  M = BCLK: GOSUB 330
460 NEXT I
470 RETURN
500 REM ===== SEND WORD (ADDR,DB) WITH LATCH =====
510 M = BCS: GOSUB 330
520 ARG = ADDR: GOSUB 400
530 ARG = DB:   GOSUB 400
540 M = BCS: GOSUB 320
550 M = BCS: GOSUB 330
560 RETURN
800 REM ===== IDLE LOW =====
810 BUS = (BUS AND (255 - (BDIN + BCLK + BCS)))
820 OUT P, BUS
830 RETURN
900 REM ===== SMALL DELAY (for art) =====
910 FOR D1 = 1 TO 500: NEXT D1
920 RETURN
1100 REM ===== WRITE ONE ROW =====
1110 DB = ROW(ADDR): GOSUB 500: RETURN
1200 REM ===== PUSH ROW() =====
1210 FOR R = 1 TO 8
1220  ADDR = R
1230  DB = ROW(R)
1240  GOSUB 500
1250 NEXT R
1260 RETURN
1800 REM ===== SHOW ART FRAMES (40) =====
1810 FOR F = 1 TO 40
1820  FOR R = 1 TO 8: READ ROW(R): NEXT R
1830  GOSUB 1200
1840  GOSUB 900          ' small delay
1850 NEXT F
1860 RETURN
2000 REM ===== MAX7219 INIT =====
2010 ADDR = &H9: DB = 0: GOSUB 500     ' decode off
2020 ADDR = &HA: DB = 8: GOSUB 500     ' intensity 0..15
2030 ADDR = &HB: DB = 7: GOSUB 500     ' scan-limit = 7 (8 rows)
2040 ADDR = &HC: DB = 1: GOSUB 500     ' normal op
2050 ADDR = &HF: DB = 0: GOSUB 500     ' test off
2060 RETURN
2100 REM ===== SHOW DIGITS 0..9 (with inline delay) =====
2110 RESTORE 4000
2120 FOR DG = 0 TO 9
2130  FOR R = 1 TO 8: READ ROW(R): NEXT R
2140  GOSUB 1200
2150  FOR HOLD = 1 TO 1200: NEXT HOLD  ' longer delay, no GOSUB
2160 NEXT DG
2170 RETURN
2300 REM ===== CLEAR =====
2310 FOR R = 1 TO 8
2320  ADDR = R: DB = 0: GOSUB 500
2330  ROW(R) = 0
2340 NEXT R
2350 RETURN
