10 REM === LCD1602 via SC719 (0xDA) b PRIME DISPLAY, 10-DIGIT RIGHT ALIGNED ===
20 REM SC700 / Z180 with SC719 I/O card. RS=P2, E=P3, D4..D7=P4..P7, RW=GND
30 DEFINT A-Z: DEFDBL P,N,X,D,S
40 PT=&HDA               ' set SC719 port for your LCD
50 K=0                   ' delay scale
60 RV=0                  ' 0=normal bit order, 1=reversed on P4..P7
70 '---- bit masks ----
80 RM=&H4                ' RS on P2
90 EM=&H8                ' E  on P3
100 DM=&HF0              ' data nibble on P4..P7
110 BU=0: OUT PT,BU
115 INPUT "Start from number"; ST
116 IF ST<2 THEN ST=2
120 GOSUB 3000           ' init LCD (clear once, blink off)
130 GOSUB 6000           ' prime generator
140 END
160 '===== delays per HD44780 spec =====
170 FOR I=0 TO (50*K): NEXT I: RETURN   ' short delay
190 FOR I=0 TO (2*K): NEXT I: RETURN    ' very short delay (EN pulse)
210 FOR I=0 TO (2500*K): NEXT I: RETURN ' long delay (clear/home)
230 RETURN
240 '===== low-level LCD write =====
250 IF FL THEN BU=BU OR RM ELSE BU=BU AND (255-RM)
260 NB=NB AND &HF
270 IF RV=0 THEN VV=NB*16 ELSE VV=((NB AND 1)*128)+((NB AND 2)*32)+((NB AND 4)*8)+((NB AND 8)*2)
280 BU=(BU AND (255-DM)) OR VV
290 OUT PT,BU: GOSUB 190
300 BU=BU OR EM: OUT PT,BU: GOSUB 190
310 BU=BU AND (255-EM): OUT PT,BU: GOSUB 190
320 RETURN
340 NB=(BY AND &HF0)\16: GOSUB 250
350 NB=BY AND &HF: GOSUB 250
360 RETURN
380 FL=0: GOSUB 340
390 IF BY=&H1 OR BY=&H2 THEN GOSUB 210 ELSE GOSUB 170
400 RETURN
420 FL=1: GOSUB 340: GOSUB 170: RETURN
440 '===== helpers =====
450 IF R0=0 THEN BA=&H0 ELSE BA=&H40
460 BY=&H80+BA+C0: GOSUB 380: RETURN
480 C0=C: R0=R: GOSUB 450
490 FOR J=1 TO LEN(S$): BY=ASC(MID$(S$,J,1)): GOSUB 420: NEXT J
500 RETURN
3000 '===== LCD init =====
3010 GOSUB 210
3020 FL=0: NB=&H3: GOSUB 250: GOSUB 210
3030 NB=&H3: GOSUB 250: GOSUB 210
3040 NB=&H3: GOSUB 250: GOSUB 210
3050 NB=&H2: GOSUB 250: GOSUB 170
3060 BY=&H28: GOSUB 380
3070 BY=&H8: GOSUB 380
3080 BY=&H1: GOSUB 380
3090 BY=&H6: GOSUB 380
3100 BY=&HC: GOSUB 380
3110 RETURN
5000 '===== format number right-aligned =====
5010 S$=STR$(N): IF LEFT$(S$,1)=" " THEN S$=MID$(S$,2)
5020 PAD$=STRING$(10-LEN(S$)," ")+S$
5030 RETURN
6000 '===== prime loop =====
6010 PN=ST
6020 IF PN<2 THEN PN=2
6025 IF PN>2 AND (PN/2=INT(PN/2)) THEN PN=PN+1
6030 GOSUB 7000: IF IS THEN GOSUB 6100
6040 IF PN=2 THEN PN=3 ELSE PN=PN+2
6050 GOTO 6030
6100 N=PN: GOSUB 5000: C=6: R=0: S$=PAD$: GOSUB 480
6110 FOR T=1 TO 100: NEXT T
6120 RETURN
7000 '===== primality test =====
7010 IF PN<2 THEN IS=0: RETURN
7020 IF PN=2 OR PN=3 OR PN=5 THEN IS=1: RETURN
7030 IF (PN/2=INT(PN/2)) THEN IS=0: RETURN
7040 IF (PN/3=INT(PN/3)) THEN IS=0: RETURN
7050 LM=INT(SQR(PN))
7060 IS=1
7070 DV=5
7080 WHILE DV<=LM
7090 IF PN/DV=INT(PN/DV) THEN IS=0: RETURN
7100 IF (DV+2)<=LM THEN IF PN/(DV+2)=INT(PN/(DV+2)) THEN IS=0: RETURN
7110 DV=DV+6
7120 WEND
7130 RETURN
