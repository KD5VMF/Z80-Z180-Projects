10 REM MAX7219 LAMP TEST + PORT SCAN (MBASIC-80 Rev 5.21)
20 DEFINT A-Z
30 BDIN=1
40 BCS=2
50 BCLK=4
60 BASE=0
70 PRINT "Scanning ports... matrix should FLASH on the right one."
80 GOSUB 2000
90 PRINT "Done. If you saw a flash, note the 'Found' port and use it in your main program."
100 END

300 REM --- SLOW SEND: ADDR/DB over DIN/CLK/CS on port P ---
310 OUT P, BASE
320 BA=ADDR
330 BT=128
340 IF (BA AND BT)<>0 THEN T=BASE+BDIN ELSE T=BASE
350 OUT P,T
360 OUT P,T+BCLK
370 OUT P,T
380 BT=BT\2
390 IF BT>0 THEN 340
400 BA=DB
410 BT=128
420 IF (BA AND BT)<>0 THEN T=BASE+BDIN ELSE T=BASE
430 OUT P,T
440 OUT P,T+BCLK
450 OUT P,T
460 BT=BT\2
470 IF BT>0 THEN 420
480 OUT P,BASE+BCS
490 OUT P,BASE
500 RETURN

800 REM --- INIT CHIP: no-decode, intensity=8, scan=7, normal ---
810 ADDR=&H09: DB=0: GOSUB 300
820 ADDR=&H0A: DB=8: GOSUB 300
830 ADDR=&H0B: DB=7: GOSUB 300
840 ADDR=&H0C: DB=1: GOSUB 300
850 ADDR=&H0F: DB=0: GOSUB 300
860 RETURN

900 REM --- SMALL DELAY ---
910 FOR D=1 TO 800: NEXT D
920 RETURN

2000 REM --- TRY COMMON PORTS ---
2010 RESTORE 9000
2020 READ P
2030 IF P<0 THEN RETURN
2040 PRINT "Trying port";P
2050 GOSUB 800
2060 ADDR=&H0F: DB=1: GOSUB 300
2070 GOSUB 900
2080 ADDR=&H0F: DB=0: GOSUB 300
2090 PRINT "  (If you saw ALL LEDs on briefly, FOUND port =";P;")"
2100 GOTO 2020

9000 DATA 0,16,32,48,64,80,96,112,128,144,160,176,192,208,224,240,-1
